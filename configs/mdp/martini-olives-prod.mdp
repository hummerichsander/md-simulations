; Production NVT MD — MARTINI CG
; Mirrors AMBER19/OPC Langevin NVT settings at 300 K as closely as possible
;
;   AA:  dt=0.002 ps, nsteps=250 000 000 → 500 ns, output every 500 steps = 1 ps
;   CG:  dt=0.020 ps, nsteps= 25 000 000 → 500 ns, output every  50 steps = 1 ps
;
; Note: MARTINI dynamics are ~4× faster than real time due to the smoother CG
; energy landscape, so 500 ns CG time corresponds to ~2 µs effective time.

; --- Integrator -----------------------------------------------------------
integrator               = sd           ; stochastic dynamics (Langevin), matches AMBER Langevin integrator
nsteps                   = 100000000     ; 2000 ns at 20 fs/step
dt                       = 0.02         ; 20 fs — standard MARTINI timestep

; --- Output (1 ps cadence, matching AA output-freq=500 × 0.002 ps = 1 ps) -
nstxout-compressed       = 50
compressed-x-precision   = 1000
nstlog                   = 500          ; log every 10 ps
nstenergy                = 50           ; energy every 1 ps

; --- Non-bonded interactions (standard MARTINI reaction-field) -------------
cutoff-scheme            = Verlet
verlet-buffer-tolerance  = 0.005
nstlist                  = 20
vdwtype                  = cutoff
vdw-modifier             = Potential-shift
rvdw                     = 1.1
rcoulomb                 = 1.1
coulombtype              = reaction-field
epsilon_rf               = 15           ; dielectric constant outside cutoff for CG water

; --- Thermostat (embedded in sd integrator) --------------------------------
; AA uses gamma=0.1 ps^-1 (tau=10 ps); MARTINI standard is tau_t=1.0 ps
; (gamma=1 ps^-1) to compensate for missing high-frequency CG degrees of freedom.
tcoupl                   = no           ; thermostat handled by sd integrator
tc-grps                  = System
tau_t                    = 1.0          ; 1/gamma; gamma=1 ps^-1
ref_t                    = 320          ; K — matches AA temperature

; --- Barostat — NVT, no pressure coupling (matches AA NVT) ----------------
pcoupl                   = no

; --- Bonds — CG bonded potentials handle connectivity ---------------------
constraints              = none

; --- Continuation from equilibration --------------------------------------
gen_vel                  = no
continuation             = yes
