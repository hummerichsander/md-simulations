integrator      = steep
nsteps          = 1000
emtol           = 100
emstep          = 0.01

nstlist         = 20
cutoff-scheme   = Verlet
ns_type         = grid
vdwtype         = cutoff
vdw-modifier    = Potential-shift
rcoulomb        = 1.1
rvdw            = 1.1
coulombtype     = reaction-field
epsilon_rf      = 15

constraints     = none