# Simulation data and outputs — never committed (but keep the data/ README).
data/*
!data/README.md
output/
slurm/output/
beamtime/
*.dcd
*.xtc
*.trr
*.edr
*.tpr
*.cpt
*.log
forces.txt
energies.csv
final_structure.pdb

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.python-version.local

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Crash and shell droppings. Core dumps land in the cwd a job ran from, so a crashed
# slurm run drops a multi-hundred-MB core.<pid> straight into the repo root. The `=*`
# catches the file an unquoted `uv add pkg>=1.2` redirect leaves behind.
core.[0-9]*
=*

# Environment
.env

# Generated reference frames for the examples. `examples/*/data/` is not covered by the
# `data/*` rule above, which is anchored to the repo root. The frames are trajectory data
# (5 MB and up) and every example ships the script that rebuilds them, so only the small
# inputs -- topologies and starting structures -- are tracked.
examples/*/data/*.npy
examples/*/data/*.dcd
examples/*/data/*.trr

# Per-system configs rendered from a template by the slurm dispatchers (e.g.
# equilibrate-h-bonds-alaX.sh expanding alaX-amber14-implicit-unconstrained-330K.yaml). They must
# outlive the dispatcher because the array job reads the path later, but they are reproducible.
configs/generated/
