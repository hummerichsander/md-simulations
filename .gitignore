# Trajectories and run output -- never committed (tests and examples still produce them).
*.dcd
*.xtc
*.trr
*.edr
*.tpr
*.cpt
*.log
forces.txt
energies.csv
final_structure.pdb

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.python-version.local

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Crash and shell droppings. Core dumps land in the cwd a job ran from, so a crashed
# slurm run drops a multi-hundred-MB core.<pid> straight into the repo root. The `=*`
# catches the file an unquoted `uv add pkg>=1.2` redirect leaves behind.
core.[0-9]*
=*

# Stray run output. Nothing in this repo is a workspace any more -- the configs, the
# data and the run store live in the sibling `simulations` repo -- but an `md-sim run`
# started here still falls back to the git root for beamtime's store, and
# `md-sim-umbrella` defaults its --output-dir to `output`.
beamtime/
output/

# Environment
.env

# Generated reference frames for the examples. The frames are trajectory data (5 MB and up)
# and every example ships the script that rebuilds them, so only the small inputs --
# topologies and starting structures -- are tracked.
examples/*/data/*.npy
examples/*/data/*.dcd
examples/*/data/*.trr

# Editor directories, and the empty placeholders the sandbox bind-mounts over the
# shell dotfiles it hides from $HOME. Neither is part of the project; the mounts
# reappear each session and cannot be removed from inside it.
.idea
.vscode
.bash_profile
.bashrc
.profile
.zprofile
.zshrc
.gitconfig
.ripgreprc
# Also a placeholder mount, not a real submodule file. If this repo ever gains a
# genuine submodule, `git add -f .gitmodules` it and drop this line.
.gitmodules

.claude
.mcp.json